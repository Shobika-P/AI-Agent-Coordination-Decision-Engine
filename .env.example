# ============================================================
# Enterprise AI Decision Automation System Environment Config
# ============================================================

# Google Gemini API Key (Get key at https://aistudio.google.com/)
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini Model Priority Chain (Configurable fallback hierarchy)
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_LIGHTWEIGHT_MODEL=gemini-3.5-flash-lite

# Request Timeout in Seconds for Deep Structured Multi-Agent Prompts
GEMINI_TIMEOUT_SECONDS=45.0

# Circuit Breaker Cooldown in Seconds
GEMINI_COOLDOWN_SECONDS=15.0

# Circuit Breaker Consecutive Failure Threshold
GEMINI_CIRCUIT_FAILURE_THRESHOLD=3

# Flask Server Port & Host Configuration
PORT=5000
HOST=0.0.0.0
FLASK_DEBUG=false

# CORS Allowed Origins (Comma-separated or * for public access)
ALLOWED_ORIGINS=*

