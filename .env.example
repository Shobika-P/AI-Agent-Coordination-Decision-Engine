# ============================================================
# ENTERPRISE DECISION AUTOMATION SYSTEM - ENVIRONMENT CONFIG
# ============================================================

# Google Gemini API Key (Required for live multi-agent AI decision engine)
GOOGLE_API_KEY=your_gemini_api_key_here

# Gemini Model Selection & Resilience Chain
GEMINI_MODEL=gemini-3.7-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash
GEMINI_LIGHTWEIGHT_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=45.0

# Authentication & Cryptographic Token Signatures
AUTH_SECRET_KEY=your-secure-random-secret-key-for-session-and-tokens-here
SECRET_KEY=your-flask-secret-key-here
TOKEN_EXPIRATION_SECONDS=2592000

# Server & Deployment Configuration
PORT=5000
HOST=0.0.0.0
FLASK_DEBUG=false
ALLOWED_ORIGINS=*

# Frontend API Base URL (Used during frontend build/deploy)
# VITE_API_BASE_URL=https://your-backend-domain.com
